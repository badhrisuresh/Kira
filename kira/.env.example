# Copy this file to .env and fill in your keys.
# GOOGLE_API_KEY — get one at https://aistudio.google.com/apikey
# FAL_KEY — get one at https://fal.ai/dashboard

GOOGLE_API_KEY=
FAL_KEY=

# --- Cloud Run only (leave unset for local dev) ---

# GCS bucket for persisting memory.json across container restarts.
# Without this, memory.json is read/written on local disk, which does
# not survive Cloud Run scaling to zero.
GCS_BUCKET_NAME=

# Base64-encoded YouTube OAuth token JSON: base64 token.json
# Without this, upload_to_youtube() falls back to the local token.pickle.
YOUTUBE_TOKEN_JSON=

# Base64-encoded client_secret.json, kept for reference if the OAuth
# flow ever needs to be re-run: base64 client_secret.json
YOUTUBE_CLIENT_SECRET_JSON=
